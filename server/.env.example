# Comma-separated frontend origins allowed to call the API (local dev only;
# in the deployed Worker the same origin serves both, set via wrangler vars).
CLIENT_ORIGIN=http://localhost:5173

# Clerk instance issuer (frontend API URL, no trailing slash).
# Session tokens are verified against its public JWKS endpoint.
# Development instances look like https://<name>.clerk.accounts.dev
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
